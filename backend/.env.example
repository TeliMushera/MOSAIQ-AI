# Copy this file to .env and adjust as needed.

# MongoDB connection string. A local MongoDB works fine for the demo:
#   MONGODB_URI=mongodb://127.0.0.1:27017/mosaiq
# Or use a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/mosaiq

# Port the backend API listens on
PORT=5000

# Comma separated list of origins allowed to call this API (Vite dev server default shown)
CORS_ORIGIN=http://localhost:5173

# Set to "true" to automatically load the demo investigation case (CASE-001)
# into MongoDB on server start, but only if the evidence collection is empty.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Ollama — local AI used for investigation insights. Both optional.
# If Ollama is not running, the AI insight button reports it and nothing
# else in the application is affected.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# How long to wait for Ollama before giving up and returning a clear error.
# Raise this if the model is large or the machine is slow — the first request
# after `ollama serve` also has to load the model into memory.
OLLAMA_TIMEOUT_MS=90000
